{
  "name": "opencli-plugin-multcloud",
  "version": "1.3.9",
  "description": "Drive MultCloud from the command line: cloud-to-cloud transfer, sync, backup, offline remote upload, Cloud Explorer and task observability. Every write is verified by read-back.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=20.0.0" },
  "bin": {
    "multcloud": "./bin/multcloud.js",
    "mc-cli": "./bin/multcloud.js"
  },
  "main": "./src/client.js",
  "exports": {
    ".": "./src/client.js",
    "./tasks": "./src/tasks.js",
    "./clouds": "./src/clouds.js",
    "./explorer": "./src/explorer.js"
  },
  "files": [
    "bin/", "src/", "docs/", "*.js",
    "opencli-plugin.json", "CHANGELOG.md", "README.md", "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:live": "MULTCLOUD_LIVE=1 node --test --test-concurrency=1 tests/live/*.test.js",
    "test:all": "npm test && npm run test:live",
    "record": "node tests/harness/record.js"
  },
  "peerDependencies": { "@jackwener/opencli": ">=1.8.7" },
  "repository": { "type": "git", "url": "git+https://github.com/vecyang1/opencli-plugin-multcloud.git" },
  "bugs": { "url": "https://github.com/vecyang1/opencli-plugin-multcloud/issues" },
  "homepage": "https://github.com/vecyang1/opencli-plugin-multcloud#readme",
  "keywords": [
    "opencli", "opencli-plugin", "multcloud", "cloud-transfer", "cloud-sync",
    "cloud-backup", "remote-upload", "magnet", "google-drive", "onedrive",
    "baidu-netdisk", "agentic-cli"
  ]
}
