# MultCloud CLI Optional Environment Configuration
# Copy to .env only if overriding defaults; no secrets are required for desktop bridge mode.

# Custom directory for local task aliases (default: ~/.multcloud)
MULTCLOUD_HOME=~/.multcloud

# Transport backend: auto (default) | opencli | headless | cloud
MULTCLOUD_BACKEND=auto

# Optional remote Cloud VPS SSH host and binary path when using --vps / MULTCLOUD_BACKEND=cloud
MULTCLOUD_VPS_HOST=multcloud-vps
MULTCLOUD_VPS_BIN=/usr/local/bin/multcloud

# Optional headless session file and Chrome binary path when running in headless mode
MULTCLOUD_SESSION_FILE=/opt/multcloud-daemon/session.json
CHROME_BIN=/usr/bin/google-chrome
